#cloud-config
package_update: true
package_upgrade: true
packages:
  - age
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-v2
  - gzip
  - unattended-upgrades
  - ufw

users:
  - name: ops
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: true
  - name: deploy
    groups: [docker]
    shell: /bin/sh
    lock_passwd: true

write_files:
  - path: /etc/ssh/sshd_config.d/00-geoguessme.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      AllowUsers ops deploy
  - path: /etc/tmpfiles.d/geoguessme.conf
    permissions: "0644"
    content: |
      d /run/lock/geoguessme 0750 deploy deploy -
  - path: /home/ops/.ssh/authorized_keys
    owner: ops:ops
    permissions: "0600"
    defer: true
    content: |
      ${admin_key}
  - path: /home/deploy/.ssh/authorized_keys
    owner: deploy:deploy
    permissions: "0600"
    defer: true
    content: |
      restrict,command="/opt/geoguessme/bin/forced-command.sh dev" ${dev_ci_key}
      restrict,command="/opt/geoguessme/bin/forced-command.sh production" ${production_key}
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {"log-driver":"json-file","log-opts":{"max-size":"10m","max-file":"3"},"live-restore":true}
  - path: /etc/cloudflared/token
    permissions: "0600"
    content: |
      ${tunnel_token}
  - path: /etc/systemd/system/cloudflared.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Cloudflare Tunnel
      After=network-online.target
      Wants=network-online.target
      [Service]
      Type=simple
      ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/token
      Restart=always
      RestartSec=5s
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=true
      [Install]
      WantedBy=multi-user.target
  - path: /tmp/geoguessme-runtime-bundle
    owner: root:root
    permissions: "0600"
    encoding: gzip+base64
    content: ${runtime_bundle}
  - path: /usr/local/sbin/geoguessme-install-runtime-bundle
    owner: root:root
    permissions: "0700"
    content: |
      #!/bin/sh
      set -eu
      bundle=$${1:?runtime bundle path is required}
      exec 3<"$bundle"
      IFS= read -r magic <&3
      [ "$magic" = GEOGUESSME_RUNTIME_BUNDLE_V1 ]
      lengths=''
      for _ in $(seq 1 17); do
        IFS= read -r size <&3
        case "$size" in *[!0-9]* | '') exit 1 ;; esac
        lengths="$lengths $size"
      done
      set -- $lengths
      while IFS=' ' read -r path mode; do
        [ -n "$path" ] || continue
        size=$1
        shift
        install -d -m 0755 "$(dirname "$path")"
        temporary=$(mktemp "$path.XXXXXX")
        dd if=/dev/fd/3 of="$temporary" bs=1 count="$size" 2>/dev/null
        [ "$(wc -c <"$temporary")" -eq "$size" ]
        chown root:root "$temporary"
        chmod "$mode" "$temporary"
        mv -f "$temporary" "$path"
      done <<'FILES'
      /opt/geoguessme/bin/common.sh 0755
      /opt/geoguessme/bin/deploy.sh 0755
      /opt/geoguessme/bin/forced-command.sh 0755
      /opt/geoguessme/bin/verify-deployment-hashes.sh 0755
      /opt/geoguessme/bin/backup.sh 0755
      /opt/geoguessme/bin/restore-rehearsal.sh 0755
      /opt/geoguessme/bin/health-check.sh 0755
      /opt/geoguessme/bin/alert.sh 0755
      /opt/geoguessme/bin/watch-health.sh 0755
      /opt/geoguessme/bin/watch-refresh-metrics-token.sh 0755
      /opt/geoguessme/bin/watch-capacity.sh 0755
      /opt/geoguessme/config/compose.production.yaml 0444
      /opt/geoguessme/config/compose.hosted.yaml 0444
      /opt/geoguessme/config/compose.watch.yaml 0444
      /opt/geoguessme/config/watch/Caddyfile 0444
      /opt/geoguessme/config/watch/vector.yaml 0444
      /opt/geoguessme/config/watch/victoria-metrics.yaml 0444
      FILES
  - path: /opt/geoguessme/config/runtime-revision
    owner: root:root
    permissions: "0444"
    content: |
      ${runtime_revision}
  - path: /opt/geoguessme/config/runtime-hashes
    owner: root:root
    permissions: "0444"
    content: |
      ${runtime_hashes}
  - path: /etc/systemd/system/geoguessme-backup@.service
    permissions: "0644"
    content: |
      [Unit]
      Description=GeoGuessMe %i encrypted database backup
      After=docker.service
      OnFailure=geoguessme-alert@%i.service
      [Service]
      Type=oneshot
      User=deploy
      ExecStart=/opt/geoguessme/bin/backup.sh %i scheduled
  - path: /etc/systemd/system/geoguessme-backup@.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Hourly GeoGuessMe %i backup
      [Timer]
      OnCalendar=hourly
      RandomizedDelaySec=5m
      Persistent=true
      [Install]
      WantedBy=timers.target
  - path: /etc/systemd/system/geoguessme-health@.service
    permissions: "0644"
    content: |
      [Unit]
      Description=GeoGuessMe %i host health check
      OnFailure=geoguessme-alert@%i.service
      [Service]
      Type=oneshot
      User=deploy
      ExecStart=/opt/geoguessme/bin/health-check.sh %i
  - path: /etc/systemd/system/geoguessme-health@.timer
    permissions: "0644"
    content: |
      [Timer]
      OnCalendar=*:0/15
      Persistent=true
      [Install]
      WantedBy=timers.target
  - path: /etc/systemd/system/geoguessme-restore-rehearsal@.service
    permissions: "0644"
    content: |
      [Unit]
      Description=GeoGuessMe %i isolated restore rehearsal
      After=docker.service
      OnFailure=geoguessme-alert@%i.service
      [Service]
      Type=oneshot
      User=deploy
      ExecStart=/opt/geoguessme/bin/restore-rehearsal.sh %i
  - path: /etc/systemd/system/geoguessme-restore-rehearsal@.timer
    permissions: "0644"
    content: |
      [Timer]
      OnCalendar=Sun *-*-* 03:30:00
      Persistent=true
      [Install]
      WantedBy=timers.target
  - path: /etc/systemd/system/geoguessme-alert@.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Email GeoGuessMe %i host failure alert
      [Service]
      Type=oneshot
      User=deploy
      ExecStart=/opt/geoguessme/bin/alert.sh %i
  - path: /etc/systemd/system/geoguessme-watch.service
    permissions: "0644"
    content: |
      [Unit]
      Requires=docker.service
      After=docker.service
      [Service]
      Type=oneshot
      User=deploy
      WorkingDirectory=/opt/geoguessme/config
      EnvironmentFile=-/var/lib/geoguessme/releases/production/current.env
      ExecStart=/usr/bin/docker compose -p geoguessme-watch --project-directory /opt/geoguessme/config -f /opt/geoguessme/config/compose.watch.yaml up -d
      ExecStop=/usr/bin/docker compose -p geoguessme-watch --project-directory /opt/geoguessme/config -f /opt/geoguessme/config/compose.watch.yaml down
      RemainAfterExit=true
  - path: /etc/systemd/system/geoguessme-watch-health.service
    permissions: "0644"
    content: |
      [Unit]
      After=geoguessme-watch.service
      Requires=geoguessme-watch.service
      OnFailure=geoguessme-alert@watch.service
      [Service]
      Type=oneshot
      User=deploy
      ExecStart=/opt/geoguessme/bin/watch-health.sh
  - path: /etc/systemd/system/geoguessme-watch-health.timer
    permissions: "0644"
    content: |
      [Unit]
      [Timer]
      OnCalendar=*:0/15
      Persistent=true
      [Install]
      WantedBy=timers.target
  - path: /etc/systemd/system/geoguessme-watch-refresh-metrics-token.service
    permissions: "0644"
    content: |
      [Unit]
      After=geoguessme-watch.service
      [Service]
      Type=oneshot
      User=root
      ExecStart=/opt/geoguessme/bin/watch-refresh-metrics-token.sh
  - path: /etc/systemd/system/geoguessme-watch-refresh-metrics-token.timer
    permissions: "0644"
    content: |
      [Unit]
      [Timer]
      OnCalendar=*:0/5
      Persistent=true
      [Install]
      WantedBy=timers.target
  - path: /etc/systemd/system/geoguessme-watch-capacity.service
    permissions: "0644"
    content: |
      [Unit]
      After=docker.service
      [Service]
      Type=oneshot
      User=deploy
      ExecStart=/opt/geoguessme/bin/watch-capacity.sh
  - path: /etc/systemd/system/geoguessme-watch-capacity.timer
    permissions: "0644"
    content: |
      [Unit]
      [Timer]
      OnCalendar=*:0/5
      Persistent=true
      [Install]
      WantedBy=timers.target

runcmd:
  - [mkdir, -p, /etc/geoguessme/age, /etc/geoguessme/watch-metrics, /opt/geoguessme/bin, /opt/geoguessme/config/watch, /opt/geoguessme/dev, /opt/geoguessme/production, /opt/geoguessme/releases, /var/lib/geoguessme/backups, /var/lib/geoguessme/releases]
  - [/usr/local/sbin/geoguessme-install-runtime-bundle, /tmp/geoguessme-runtime-bundle]
  - [rm, -f, /usr/local/sbin/geoguessme-install-runtime-bundle, /tmp/geoguessme-runtime-bundle]
  - [chown, -R, deploy:deploy, /opt/geoguessme/dev, /opt/geoguessme/production, /opt/geoguessme/releases, /var/lib/geoguessme]
  - [systemd-tmpfiles, --create, /etc/tmpfiles.d/geoguessme.conf]
  - [chmod, "0555", /opt/geoguessme/bin, /opt/geoguessme/config, /opt/geoguessme/config/watch]
  - [chown, root:docker, /etc/geoguessme/watch-metrics]
  - [chmod, "0750", /etc/geoguessme/watch-metrics]
  - [chown, deploy:deploy, /etc/geoguessme]
  - [sh, -c, "set -eu; umask 077; age-keygen -o /etc/geoguessme/age/dev.txt; age-keygen -y /etc/geoguessme/age/dev.txt > /etc/geoguessme/age/dev-recipient.txt; age-keygen -o /etc/geoguessme/age/production.txt; age-keygen -y /etc/geoguessme/age/production.txt > /etc/geoguessme/age/production-recipient.txt"]
  - [chmod, "0600", /etc/geoguessme/age/dev.txt, /etc/geoguessme/age/production.txt]
  - [chmod, "0644", /etc/geoguessme/age/dev-recipient.txt, /etc/geoguessme/age/production-recipient.txt]
  - [chown, -R, deploy:deploy, /etc/geoguessme/age]
  - [sh, -c, "curl -fsSLo /tmp/cloudflared.deb https://github.com/cloudflare/cloudflared/releases/download/2026.7.2/cloudflared-linux-amd64.deb"]
  - [sh, -c, "echo '88195157a136199a86977c122a22084dae6907480bbe3640222b7b55834afc3a  /tmp/cloudflared.deb' | sha256sum -c -"]
  - [dpkg, -i, /tmp/cloudflared.deb]
  - [rm, -f, /tmp/cloudflared.deb]
  - [sh, -c, "fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile && echo '/swapfile none swap sw 0 0' >> /etc/fstab"]
  - [ufw, default, deny, incoming]
  - [ufw, default, allow, outgoing]
  - [ufw, allow, in, "on", lo, to, any]
  - [ufw, --force, enable]
  - [systemctl, restart, ssh]
  - [systemctl, restart, docker]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, cloudflared.service]
  - [systemctl, enable, --now, geoguessme-backup@dev.timer, geoguessme-backup@production.timer]
  - [systemctl, enable, --now, geoguessme-health@dev.timer, geoguessme-health@production.timer]
  - [systemctl, enable, --now, geoguessme-restore-rehearsal@production.timer]
  # Monitoring is installed but deliberately not enabled until the operator
  # has completed the capacity gate and created the Beszel/metrics secrets.
  - [systemctl, daemon-reload]

final_message: "GeoGuessMe host bootstrap complete"
