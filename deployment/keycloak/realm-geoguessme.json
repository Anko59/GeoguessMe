{
  "realm": "geoguessme",
  "enabled": true,
  "displayName": "GeoGuessMe",
  "loginTheme": "geoguessme",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": true,
  "rememberMe": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "webAuthnPolicyRpEntityName": "GeoGuessMe",
  "webAuthnPolicyRpId": "${GEOGUESSME_WEBAUTHN_RP_ID}",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "webAuthnPolicySignatureAlgorithms": ["ES256", "RS256", "EdDSA"],
  "webAuthnPolicyAcceptableAaguids": [],
  "webAuthnPolicyPasswordlessRpEntityName": "GeoGuessMe",
  "webAuthnPolicyPasswordlessRpId": "${GEOGUESSME_WEBAUTHN_RP_ID}",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": ["ES256", "RS256", "EdDSA"],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": { "addRecoveryCodes": "true" }
    },
    {
      "alias": "webauthn-register",
      "name": "Webauthn Register",
      "providerId": "webauthn-register",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "WebAuthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "geoguessme-production",
      "name": "GeoGuessMe production BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "${GEOGUESSME_PRODUCTION_OIDC_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["${GEOGUESSME_PRODUCTION_REDIRECT_URL}"],
      "webOrigins": ["${GEOGUESSME_PRODUCTION_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${GEOGUESSME_PRODUCTION_POST_LOGOUT_URLS}"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "geoguessme-production",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "geoguessme-dev",
      "name": "GeoGuessMe development BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "${GEOGUESSME_DEV_OIDC_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["${GEOGUESSME_DEV_REDIRECT_URL}"],
      "webOrigins": ["${GEOGUESSME_DEV_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${GEOGUESSME_DEV_POST_LOGOUT_URLS}"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "geoguessme-dev",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GEOGUESSME_GOOGLE_CLIENT_ID}",
        "clientSecret": "${GEOGUESSME_GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "FORCE",
        "useJwksUrl": "true"
      }
    },
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GEOGUESSME_GITHUB_CLIENT_ID}",
        "clientSecret": "${GEOGUESSME_GITHUB_CLIENT_SECRET}",
        "defaultScope": "user:email",
        "syncMode": "FORCE"
      }
    },
    {
      "alias": "apple",
      "displayName": "Apple",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "https://appleid.apple.com/auth/authorize",
        "tokenUrl": "https://appleid.apple.com/auth/token",
        "issuer": "https://appleid.apple.com",
        "jwksUrl": "https://appleid.apple.com/auth/keys",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientAuthMethod": "client_secret_post",
        "clientId": "${GEOGUESSME_APPLE_CLIENT_ID}",
        "clientSecret": "${GEOGUESSME_APPLE_CLIENT_SECRET}",
        "defaultScope": "openid email name",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "FORCE"
      }
    }
  ]
}
