# Development environment template.
# Copy to deployment/env/development.env (or .env at the repo root) and adjust.
# All variables are optional in development; sensible MinIO/Mailpit defaults apply.

APP_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL 15 development database.
DATABASE_URL=postgres://user:password@localhost:5432/geoguessme?sslmode=disable
DB_MIN_CONNS=2
DB_MAX_CONNS=10

# Generate with: openssl rand -base64 48
JWT_SECRET=dev_secret_key_change_me_please_32_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
VERIFICATION_TOKEN_TTL=24h
RESET_TOKEN_TTL=1h
BCRYPT_COST=10

# Browser origins allowed for CORS and WebSocket upgrades.
ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated CIDRs trusted to set X-Forwarded-For/X-Real-IP (empty in dev).
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_LOGIN=identity:10/1m,trustedIP:30/1m,global:300/1m
RATE_LIMIT_SIGNUP=identity:3/1h,trustedIP:5/1h,global:60/1m
RATE_LIMIT_EMAIL=identity:3/1h,trustedIP:5/1h,global:30/1m
RATE_LIMIT_RESET=trustedIP:10/1h
RATE_LIMIT_PUSH=user:10/1h,trustedIP:20/1h
RATE_LIMIT_DEFAULT=identity:10/1m,trustedIP:60/1m
RATE_LIMIT_FAIL_CLOSED=login,signup,email,reset
RATE_LIMIT_STORE_CAP=50000

# MinIO locally; use a private S3-compatible bucket in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=geoguessme-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
# Set to "local" to store media on disk instead of S3.
STORAGE_DRIVER=
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
AVATAR_MAX_BYTES=26214400
UPLOAD_MAX_PIXELS=25000000
# The in-process media-processing worker promotes quarantined video uploads.
# On by default; set to false to disable video processing.
MEDIA_PROCESSING_WORKER=true

# Gameplay timing.
CHALLENGE_TTL=24h
PHOTO_VIEW_WINDOW=10s
GUESS_WINDOW=2m
PHOTO_RETENTION=720h

# Mailpit locally; production requires authenticated SMTP with TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
# One of: off | starttls | tls (off only valid outside production).
SMTP_TLS=off
SMTP_DIAL_TIMEOUT=10s
SMTP_TIMEOUT=30s

# Web Push: optional in development (ephemeral keys are generated at startup).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@localhost
# Comma-separated DNS allowlist of push delivery hosts. Defaults to the four
# major provider families when unset.
PUSH_ENDPOINT_ALLOWLIST=fcm.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com

# Web Push lifecycle and delivery bounds (F-08).
PUSH_MAX_SUBSCRIPTIONS_PER_USER=5
PUSH_SUBSCRIPTION_EXPIRY=2160h
PUSH_DELIVERY_WORKERS=4
PUSH_DELIVERY_PER_HOST=2
PUSH_DELIVERY_TIMEOUT=5s
PUSH_QUEUE_DEPTH=256
