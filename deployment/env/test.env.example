# Test environment template.
# Used by deployment/compose.test.yaml. The isolated stack uses a one-second
# viewing window so challenge timing can be exercised deterministically.

APP_ENV=test
PORT=8080
PUBLIC_URL=http://localhost:8080
LOG_LEVEL=info

DATABASE_URL=postgres://test:test@db:5432/geoguessme_test?sslmode=disable
DB_MIN_CONNS=2
DB_MAX_CONNS=10

JWT_SECRET=test_secret_key_at_least_32_characters_long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
VERIFICATION_TOKEN_TTL=24h
RESET_TOKEN_TTL=1h
BCRYPT_COST=4

ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_LOGIN=identity:10/1m,trustedIP:50000/1m,global:300/1m
RATE_LIMIT_SIGNUP=identity:3/1h,trustedIP:50000/1h,global:1000/1m
RATE_LIMIT_EMAIL=identity:3/1h,trustedIP:50000/1h,global:1000/1m
RATE_LIMIT_RESET=trustedIP:10/1h
RATE_LIMIT_PUSH=user:10/1h,trustedIP:20/1h
RATE_LIMIT_DEFAULT=identity:10/1m,trustedIP:50000/1m
RATE_LIMIT_FAIL_CLOSED=login,signup,email,reset
RATE_LIMIT_STORE_CAP=50000

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=geoguessme-test-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
STORAGE_DRIVER=
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
AVATAR_MAX_BYTES=26214400
UPLOAD_MAX_PIXELS=25000000
# The in-process media-processing worker promotes quarantined video uploads.
# On by default; set to false to disable video processing.
MEDIA_PROCESSING_WORKER=true

CHALLENGE_TTL=24h
PHOTO_VIEW_WINDOW=1s
GUESS_WINDOW=5m
PHOTO_RETENTION=720h

PARTY_TIME_DURATION=1h
PARTY_TIME_COOLDOWN=48h

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@test.local
SMTP_TLS=off
SMTP_DIAL_TIMEOUT=10s
SMTP_TIMEOUT=30s

# Web Push is disabled in the test stack (no VAPID keys). The allowlist is
# documented here for parity; the default covers the four major providers.
PUSH_ENDPOINT_ALLOWLIST=fcm.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com

# Web Push lifecycle and delivery bounds (F-08). The stack keeps push disabled
# (no VAPID keys); the values document the production defaults.
PUSH_MAX_SUBSCRIPTIONS_PER_USER=5
PUSH_SUBSCRIPTION_EXPIRY=2160h
PUSH_DELIVERY_WORKERS=4
PUSH_DELIVERY_PER_HOST=2
PUSH_DELIVERY_TIMEOUT=5s
PUSH_QUEUE_DEPTH=256
