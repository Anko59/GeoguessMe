# Encrypt the completed file with the dev age recipient; never commit plaintext.
APP_ENV=production
PORT=8080
PUBLIC_URL=https://dev.geoguessme.com
LOG_LEVEL=info
POSTGRES_USER=geoguessme
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=geoguessme
DATABASE_URL=postgres://geoguessme:replace-with-url-escaped-password@postgres/geoguessme?sslmode=disable
DB_MIN_CONNS=0
DB_MAX_CONNS=5
JWT_SECRET=replace-with-random-base64-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
VERIFICATION_TOKEN_TTL=24h
RESET_TOKEN_TTL=1h
BCRYPT_COST=12
ALLOWED_ORIGINS=https://dev.geoguessme.com
TRUSTED_PROXY_CIDRS=172.16.0.0/12
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_LOGIN=identity:10/1m,trustedIP:30/1m,global:300/1m
RATE_LIMIT_SIGNUP=identity:3/1h,trustedIP:5/1h,global:60/1m
RATE_LIMIT_EMAIL=identity:3/1h,trustedIP:5/1h,global:30/1m
RATE_LIMIT_RESET=trustedIP:10/1h
RATE_LIMIT_PUSH=user:10/1h,trustedIP:20/1h
RATE_LIMIT_DEFAULT=identity:10/1m,trustedIP:60/1m
RATE_LIMIT_FAIL_CLOSED=login,signup,email,reset
RATE_LIMIT_STORE_CAP=50000
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=geoguessme-dev-media
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_USE_PATH_STYLE=true
UPLOAD_MAX_BYTES=10485760
AVATAR_MAX_BYTES=26214400
UPLOAD_MAX_PIXELS=25000000
# The in-process media-processing worker promotes quarantined video uploads.
# On by default; set to false to disable video processing.
MEDIA_PROCESSING_WORKER=true
CHALLENGE_TTL=24h
PHOTO_VIEW_WINDOW=10s
GUESS_WINDOW=2m
LOCATION_HIDE_DURATION=48h
PHOTO_RETENTION=720h

PARTY_TIME_DURATION=1h
PARTY_TIME_COOLDOWN=48h
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@geoguessme.com
SMTP_TLS=starttls
SMTP_DIAL_TIMEOUT=10s
SMTP_TIMEOUT=30s
METRICS_TOKEN=replace-with-random-hex-secret
GHCR_USERNAME=replace-me
GHCR_TOKEN=replace-with-read-packages-token
# Required because APP_ENV is production above: the backend refuses to start
# without a stable Web Push keypair. Generate with `geoguessme vapid-keys`.
VAPID_PUBLIC_KEY=replace-with-output-of-geoguessme-vapid-keys
VAPID_PRIVATE_KEY=replace-with-output-of-geoguessme-vapid-keys
VAPID_SUBJECT=mailto:operator@example.com
# Required (non-empty) because Web Push is enabled in this production env.
PUSH_ENDPOINT_ALLOWLIST=fcm.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com

# Web Push lifecycle and delivery bounds (F-08).
PUSH_MAX_SUBSCRIPTIONS_PER_USER=5
PUSH_SUBSCRIPTION_EXPIRY=2160h
PUSH_DELIVERY_WORKERS=4
PUSH_DELIVERY_PER_HOST=2
PUSH_DELIVERY_TIMEOUT=5s
PUSH_QUEUE_DEPTH=256
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/geoguessme-database-backups/dev
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
RESTIC_PASSWORD=replace-with-random-backup-secret
