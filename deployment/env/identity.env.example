# Shared Keycloak runtime for https://auth.geoguessme.com. Generate and encrypt
# this file for both host age recipients; never commit its plaintext form.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace-with-random-keycloak-database-password

KC_DB=postgres
KC_DB_URL_HOST=keycloak-db
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=replace-with-the-same-keycloak-database-password
KC_BOOTSTRAP_ADMIN_USERNAME=geoguessme-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-random-keycloak-admin-password
KC_HTTP_ENABLED=true
KC_HTTP_PORT=8080
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_HOSTNAME=https://auth.geoguessme.com
KC_HOSTNAME_STRICT=true
KC_PROXY_HEADERS=xforwarded
KC_TRANSACTION_XA_ENABLED=false

GEOGUESSME_WEBAUTHN_RP_ID=auth.geoguessme.com
GEOGUESSME_PRODUCTION_OIDC_CLIENT_SECRET=replace-with-production-client-secret
GEOGUESSME_PRODUCTION_REDIRECT_URL=https://geoguessme.com/oauth2/callback
GEOGUESSME_PRODUCTION_ORIGIN=https://geoguessme.com
GEOGUESSME_PRODUCTION_POST_LOGOUT_URLS=https://geoguessme.com/*
GEOGUESSME_DEV_OIDC_CLIENT_SECRET=replace-with-dev-client-secret
GEOGUESSME_DEV_REDIRECT_URL=https://dev.geoguessme.com/oauth2/callback
GEOGUESSME_DEV_ORIGIN=https://dev.geoguessme.com
GEOGUESSME_DEV_POST_LOGOUT_URLS=https://dev.geoguessme.com/*
GEOGUESSME_GOOGLE_CLIENT_ID=replace-with-google-client-id
GEOGUESSME_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GEOGUESSME_GITHUB_CLIENT_ID=replace-with-github-client-id
GEOGUESSME_GITHUB_CLIENT_SECRET=replace-with-github-client-secret
# Apple Service ID and its signed client-secret JWT. Apple limits the JWT
# lifetime, so rotate it before its configured expiry.
GEOGUESSME_APPLE_CLIENT_ID=replace-with-apple-service-id
GEOGUESSME_APPLE_CLIENT_SECRET=replace-with-signed-apple-client-secret-jwt
