# Local fixture client only; never load as a hosted backend secret dotenv.
# Use values through the operator environment and Dockerized Make targets.
# Default project/network: ordinary make dev. Migration forces loopback endpoints
# and uses the explicit host-network client, never inherited live R2 settings.
GEOGUESSME_S3_FIXTURE_NETWORK=geoguessme-dev_default
# 32 x 64 MiB volumes gives about 2 GiB raw fixture capacity. Raise after disk
# review for larger imports; keep the same value through staging and make dev.
GEOGUESSME_S3_FIXTURE_VOLUME_MAX=32
S3_FIXTURE_ENDPOINT=http://minio:9000
S3_FIXTURE_ACCESS_KEY=minioadmin
S3_FIXTURE_SECRET_KEY=minioadmin
S3_FIXTURE_REGION=us-east-1
# For customized legacy root keys, retrieve privately and export source-prefixed
# credentials; do not copy actual values into this template or logs.
# SOURCE_S3_FIXTURE_ACCESS_KEY=minioadmin
# SOURCE_S3_FIXTURE_SECRET_KEY=minioadmin
# SOURCE_S3_FIXTURE_REGION=us-east-1
# Supply only ONE argument mode per operation:
# S3_FIXTURE_COMMAND='ensure geoguessme-media'
# S3_FIXTURE_ARGS_JSON='["ensure","geoguessme-media"]'
# HOSTED_DEPENDENCY_PROTOCOL_READY belongs in GitHub environment/repository
# variables, not here: set true only after operator host bundle verification.
